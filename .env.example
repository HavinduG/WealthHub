# Copy this file to `.env` (or `.env.local`) and fill in the values.

# --- WordPress (headless CMS) ---------------------------------------------
# Base URL of the WordPress install, no trailing slash. The REST API is read
# from `${WORDPRESS_URL}/wp-json`. Server-only: never exposed to the browser.
WORDPRESS_URL=http://wealthhub.local

# --- Site -------------------------------------------------------------------
# Public URL of this Next.js site, no trailing slash. Used for metadataBase,
# canonical URLs, sitemap.xml, robots.txt and structured data.
# While this points at localhost, robots.txt blocks all crawlers.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- On-demand revalidation ---------------------------------------------------
# Shared secret WordPress sends (header `x-revalidate-secret`) when content
# changes, so cached pages refresh immediately instead of waiting up to an hour.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WORDPRESS_REVALIDATE_SECRET=

# --- Member accounts ------------------------------------------------------------
# Encrypts the login session cookie (A256GCM). Must be 32 random bytes, base64url.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs everyone out.
SESSION_SECRET=
